---
import type { Lang } from '../i18n';

// How quawa checks a pull request: diff checks and mutation testing feed one trust card (quawa tool page).
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = {
  de: {
    label: 'So prüft quawa einen Pull Request: Diff-Prüfungen lesen nur die Änderungen, Mutation Testing baut kleine Fehler in die geänderten Zeilen ein. Beides landet in einer Vertrauenskarte mit Ampel im Pull Request.',
    pr: 'Pull Request', prSub: 'Code · Tests · CI',
    diff: 'Diff-Prüfungen', diffSub: 'schnell, ohne Testlauf',
    mut: 'Mutation Testing', mutSub: 'nur geänderte Zeilen',
    card: 'Vertrauenskarte', rows: ['Tests fangen 4 von 11 Fehlern', '1 Assertion abgeschwächt', 'CI blockiert bei Rot'],
  },
  en: {
    label: 'How quawa checks a pull request: diff checks read only the changes, mutation testing plants small bugs in the changed lines. Both end up in one trust card with a traffic light in the pull request.',
    pr: 'Pull request', prSub: 'code · tests · CI',
    diff: 'Diff checks', diffSub: 'fast, no test run',
    mut: 'Mutation testing', mutSub: 'changed lines only',
    card: 'Trust card', rows: ['Tests catch 4 of 11 bugs', '1 assertion weakened', 'CI blocks on red'],
  },
}[lang];
---
<figure class="qcheck">
  <svg viewBox="0 0 760 240" role="img" aria-label={t.label}>
    <defs><marker id="qcheck-tip" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path class="tip" d="M0 0 L10 5 L0 10z" /></marker></defs>
    <rect class="box moss" x="20" y="90" width="150" height="60" rx="10" />
    <text x="95" y="117" text-anchor="middle" class="name">{t.pr}</text>
    <text x="95" y="137" text-anchor="middle" class="sub">{t.prSub}</text>

    <rect class="box accent" x="230" y="30" width="190" height="60" rx="10" />
    <text x="325" y="57" text-anchor="middle" class="name">{t.diff}</text>
    <text x="325" y="77" text-anchor="middle" class="sub">{t.diffSub}</text>

    <rect class="box accent" x="230" y="150" width="190" height="60" rx="10" />
    <text x="325" y="177" text-anchor="middle" class="name">{t.mut}</text>
    <text x="325" y="197" text-anchor="middle" class="sub">{t.mutSub}</text>

    <rect class="box primary" x="480" y="45" width="260" height="150" rx="12" />
    <text x="500" y="75" class="name">{t.card}</text>
    <circle class="bad" cx="510" cy="105" r="8" /><text x="528" y="110" class="row">{t.rows[0]}</text>
    <circle class="fair" cx="510" cy="137" r="8" /><text x="528" y="142" class="row">{t.rows[1]}</text>
    <circle class="good" cx="510" cy="169" r="8" /><text x="528" y="174" class="row">{t.rows[2]}</text>

    <path class="arrow" d="M170 110 L226 66" />
    <path class="arrow" d="M170 130 L226 174" />
    <path class="arrow" d="M420 60 L476 90" />
    <path class="arrow" d="M420 180 L476 150" />
  </svg>
</figure>
<style>
  .qcheck { margin: 24px 0; overflow-x: auto }
  svg { display: block; width: 100%; min-width: 560px; height: auto }
  text { fill: var(--ink) }
  .name { font: 600 15px var(--font-mono) }
  .sub { font: 12px var(--font-body); fill: var(--muted) }
  .row { font: 13px var(--font-body) }
  .box { fill: var(--surface); stroke: var(--line); stroke-width: 1.5 }
  .box.primary { fill: var(--primary-soft); stroke: var(--primary) }
  .box.accent { fill: var(--accent-soft); stroke: var(--accent) }
  .box.moss { fill: var(--moss-soft); stroke: var(--moss) }
  .good { fill: #2A9D8F } .fair { fill: #E0A43A } .bad { fill: #D7381E }
  .arrow { stroke: var(--muted); stroke-width: 1.6; fill: none; marker-end: url(#qcheck-tip) }
  .tip { fill: var(--muted) }
</style>
