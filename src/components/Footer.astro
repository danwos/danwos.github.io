---
import { t, path, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---
<footer>
  <div class="wrap row">
    <span>© {new Date().getFullYear()} Daniel Woste · danwos</span>
    <span class="links">
      <a href={path(lang, 'imprint/')}>{s.footer.imprint}</a>
      <a href={path(lang, 'privacy/')}>{s.footer.privacy}</a>
    </span>
  </div>
</footer>
<style>
  footer { margin-top: 0; border-top: 10px solid; border-image: var(--stripe) 10; color: var(--muted); font-size: 14px }
  .row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding-top: 24px; padding-bottom: 40px }
  .links { display: flex; gap: 16px; flex-wrap: wrap }
  .links a { color: var(--muted) }
</style>
