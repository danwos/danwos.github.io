---
import type { Lang } from '../i18n';

// How knowledge moves through a monsterbrain: sources → concept → close-concept → facts, outputs, archive (monsterbrain tool page).
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = {
  de: { label: 'Wissensfluss: Belege fließen in ein Konzept, nach der Freigabe verteilt close-concept die Ergebnisse auf Fakten und Outputs und archiviert das Konzept.', sources: 'Belege', concept: 'Entwurf → Review → Freigabe', facts: 'die Wahrheit', outputs: 'PDF · HTML · Folien', archive: 'Konzept erledigt' },
  en: { label: 'Knowledge flow: evidence feeds a concept; once approved, close-concept moves the findings into facts and outputs and archives the concept.', sources: 'evidence', concept: 'draft → review → approved', facts: 'the truth', outputs: 'PDF · HTML · slides', archive: 'concept done' },
}[lang];
---
<figure class="flow">
  <svg viewBox="0 0 760 250" role="img" aria-label={t.label}>
    <defs><marker id="flow-tip" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path class="tip" d="M0 0 L10 5 L0 10z" /></marker></defs>
    <rect class="box moss" x="20" y="95" width="130" height="60" rx="10" />
    <text x="85" y="122" text-anchor="middle" class="name">40_sources</text>
    <text x="85" y="142" text-anchor="middle" class="sub">{t.sources}</text>

    <rect class="box accent" x="185" y="95" width="190" height="60" rx="10" />
    <text x="280" y="122" text-anchor="middle" class="name">10_concepts</text>
    <text x="280" y="142" text-anchor="middle" class="sub">{t.concept}</text>

    <rect class="box primary" x="400" y="80" width="120" height="90" rx="45" />
    <text x="460" y="120" text-anchor="middle" class="name">close-</text>
    <text x="460" y="138" text-anchor="middle" class="name">concept</text>

    <rect class="box primary" x="580" y="20" width="160" height="56" rx="10" />
    <text x="660" y="44" text-anchor="middle" class="name">20_facts</text>
    <text x="660" y="62" text-anchor="middle" class="sub">{t.facts}</text>

    <rect class="box" x="580" y="97" width="160" height="56" rx="10" />
    <text x="660" y="121" text-anchor="middle" class="name">30_outputs</text>
    <text x="660" y="139" text-anchor="middle" class="sub">{t.outputs}</text>

    <rect class="box" x="580" y="174" width="160" height="56" rx="10" />
    <text x="660" y="198" text-anchor="middle" class="name">90_archive</text>
    <text x="660" y="216" text-anchor="middle" class="sub">{t.archive}</text>

    <path class="arrow" d="M150 125 L181 125" />
    <path class="arrow" d="M375 125 L396 125" />
    <path class="arrow" d="M520 112 L576 52" />
    <path class="arrow" d="M520 125 L576 125" />
    <path class="arrow" d="M520 138 L576 200" />
  </svg>
</figure>
<style>
  .flow { margin: 24px 0; overflow-x: auto }
  svg { display: block; width: 100%; min-width: 560px; height: auto }
  text { fill: var(--ink) }
  .name { font: 600 15px var(--font-mono) }
  .sub { font: 12px var(--font-body); fill: var(--muted) }
  .box { fill: var(--surface); stroke: var(--line); stroke-width: 1.5 }
  .box.primary { fill: var(--primary-soft); stroke: var(--primary) }
  .box.accent { fill: var(--accent-soft); stroke: var(--accent) }
  .box.moss { fill: var(--moss-soft); stroke: var(--moss) }
  .arrow { stroke: var(--muted); stroke-width: 1.6; fill: none; marker-end: url(#flow-tip) }
  .tip { fill: var(--muted) }
</style>
