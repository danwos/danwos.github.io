---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A screenshot in running text (MDX pages); `float` puts a narrow detail beside the text.
// The lightbox shows it full size. How far along the pictures are is set once per page (`pictures`).
interface Props { src: ImageMetadata; alt: string; float?: boolean }
const { src, alt, float = false } = Astro.props;
---
<figure class:list={['screen', { float }]}>
  <Image src={src} alt={alt} widths={float ? [340, 680] : [800, 1600]} sizes={float ? '(max-width: 760px) 100vw, 340px' : '(max-width: 860px) 100vw, 800px'} data-full={src.src} />
</figure>
<style>
  .screen { margin: 24px 0 }
  .screen img { margin: 0 }
  .screen.float { float: right; width: 340px; margin: 4px 0 16px 28px }
  @media (max-width: 760px) { .screen.float { float: none; width: 100%; margin: 16px 0 } }
</style>
