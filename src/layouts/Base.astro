---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { t, locales, switchPath, type Lang } from '../i18n';

interface Props {
  lang: Lang; title?: string; description?: string;
  /** Link preview image (path under /og/), e.g. "blog/my-post" – default: the crew card */
  og?: string;
  /** Blog posts: shown as article with date and tags in link previews */
  article?: { published: Date; tags: string[] };
}
const { lang, title, description, og = 'default', article } = Astro.props;
const s = t(lang);
const pageTitle = title ? `${title} – danwos` : s.meta.title;
const site = Astro.site!;
const desc = description ?? s.meta.description;
const url = new URL(Astro.url.pathname, site);
const ogImage = new URL(`/og/${lang}/${og}.png`, site);
// deciwa review overlay: only with ?deciwa in the address; PUBLIC_DECIWA_SRC points to a local build
const deciwaSrc = import.meta.env.PUBLIC_DECIWA_SRC ?? 'https://deciwa.danwos.dev/js/0.2/deciwa.js';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={url} />
    <!-- Link previews (LinkedIn, X, Slack …); images from src/pages/og/ -->
    <meta property="og:site_name" content="danwos" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? s.meta.title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? s.meta.title} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:author" content="Daniel Woste" />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? s.meta.title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchPath(Astro.url.pathname, l as Lang), site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site)} />
    <link rel="alternate" type="application/rss+xml" title={`danwos – Blog (${lang})`} href={`/${lang}/rss.xml`} />
    <!-- Set the chosen theme before the first paint; without a choice the browser setting applies. -->
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <script is:inline src={deciwaSrc} defer data-activate="param"></script>
  </head>
  <body>
    <a class="skip" href="#main">{s.nav.skip}</a>
    <Nav lang={lang} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <Lightbox lang={lang} />
  </body>
</html>
