---
// Maintenance page, German and English on one page. Built always; scripts/maintenance.mjs
// copies it over every page when MAINTENANCE=1 and removes it otherwise.
import '../styles/global.css';
import { Image } from 'astro:assets';
import monster from '../assets/monsters/danwos.webp';
import logoLight from '../assets/logo/logo-horizontal.svg';
import logoDark from '../assets/logo/logo-horizontal-dark.svg';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>danwos – Wartung / Maintenance</title>
    <meta name="description" content="danwos.dev wird gerade umgebaut. · danwos.dev is being rebuilt." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <main class="wrap">
      <Image class="monster" src={monster} alt="Das danwos-Monster" widths={[280, 560]} sizes="280px" loading="eager" />
      <img class="logo logo-light" src={logoLight.src} alt="danwos" width="150" height="40" />
      <img class="logo logo-dark" src={logoDark.src} alt="danwos" width="150" height="40" />
      <h1>Wir bauen gerade um.</h1>
      <p class="lead">danwos.dev ist in ein paar Tagen wieder da.</p>
      <p class="lead en" lang="en">We are rebuilding. danwos.dev will be back in a few days.</p>
      <p class="contact">
        <a class="btn btn-primary" href="mailto:daniel.woste@gmail.com">E-Mail</a>
        <a class="btn btn-secondary" href="https://www.linkedin.com/in/daniel-woste-362b6252/">LinkedIn</a>
      </p>
    </main>
    <footer>
      <div class="wrap row">
        <span>© {new Date().getFullYear()} Daniel Woste · danwos</span>
        <span class="links">
          <a href="/de/imprint/">Impressum</a>
          <a href="/de/privacy/">Datenschutz</a>
          <a href="/en/imprint/" lang="en">Imprint</a>
          <a href="/en/privacy/" lang="en">Privacy</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  body { min-height: 100vh; display: flex; flex-direction: column }
  main { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding-top: 48px; padding-bottom: 48px }
  .monster { width: min(55vw, 220px); height: auto; max-height: 36vh; object-fit: contain; margin-bottom: 12px }
  .logo { height: 36px; width: auto; margin-bottom: 8px }
  .logo-dark { display: none }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .logo-light { display: none }
    :global(:root:not([data-theme="light"])) .logo-dark { display: block }
  }
  :global(:root[data-theme="dark"]) .logo-light { display: none }
  :global(:root[data-theme="dark"]) .logo-dark { display: block }
  .lead { margin-left: auto; margin-right: auto }
  .en { font-size: 17px }
  .contact { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 16px }
  footer { border-top: 10px solid; border-image: var(--stripe) 10; color: var(--muted); font-size: 14px }
  .row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding-top: 24px; padding-bottom: 40px }
  .links { display: flex; gap: 16px; flex-wrap: wrap }
  .links a { color: var(--muted) }
</style>
