---
import { getCollection, render } from 'astro:content';
import { langOf } from '../../../lib/content';
import Base from '../../../layouts/Base.astro';
import Split from '../../../components/Split.astro';
import PageToc from '../../../components/PageToc.astro';
import { t, locales, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const s = t(lang);
// Body text comes from src/content/views/<lang>/index.md once there is content.
const [entry] = await getCollection('views', (e) => langOf(e.id) === lang && !!e.body?.trim());
const { Content, headings } = entry ? await render(entry) : { Content: null, headings: [] };
---
<Base lang={lang} title={s.views.title} description={s.views.lead}>
  <section class="section head">
    <div class="wrap narrow">
      <Split monster="danwos-bricks" alt={s.views.alt}>
        <h1>{s.views.title}</h1>
        <p class="lead">{s.views.lead}</p>
      </Split>
    </div>
  </section>
  {Content && (
    <section class="section">
      <div class="wrap narrow body">
        <PageToc headings={headings} title={s.projects.toc} />
        <div class="prose"><Content /></div>
      </div>
    </section>
  )}
</Base>
<style>
  .head { padding-bottom: 32px }
  /* one centred reading column like blog posts and the about page: pictures end where the text ends */
  .narrow { max-width: 820px }
  /* the table of contents hangs in the margin left of the column */
  .body { position: relative }
</style>
