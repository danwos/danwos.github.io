---
import Base from '../../../layouts/Base.astro';
import Split from '../../../components/Split.astro';
import { ideasFor, slugOf } from '../../../lib/content';
import { t, locales, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const s = t(lang);
const ideas = (await ideasFor(lang)).map((entry) => ({ ...entry.data, slug: slugOf(entry.id) }));
// Problem, solution and tech are plain text; blank lines separate paragraphs.
const paragraphs = (text: string) => text.trim().split(/\n\s*\n/);
---
<Base lang={lang} title={s.ideas.title} description={s.ideas.pageLead}>
  <section class="section head">
    <div class="wrap">
      <Split monster="baby" alt={s.ideas.alt}>
        <h1>{s.ideas.title}</h1>
        <p class="lead">{s.ideas.pageLead}</p>
      </Split>
    </div>
  </section>
  <section class="section">
    <div class="wrap layout">
      <nav class="toc" aria-label={s.ideas.toc}>
        <p class="toc-title">{s.ideas.toc}</p>
        <ol>
          {ideas.map((i) => (
            <li><a href={`#${i.slug}`}>{i.title}</a> <span class={`status ${i.status}`}>{s.ideas.status[i.status]}</span></li>
          ))}
        </ol>
      </nav>
      <div class="ideas">
        {ideas.map((i) => (
          <article id={i.slug} class="idea">
            <h2>{i.title}</h2>
            <p class="meta">{s.ideas.statusLabel}: <span class={`status ${i.status}`}>{s.ideas.status[i.status]}</span></p>
            <p class="lead">{i.summary}</p>
            <h3>{s.ideas.problem}</h3>
            {paragraphs(i.problem).map((p) => <p>{p}</p>)}
            <h3>{s.ideas.solution}</h3>
            {paragraphs(i.solution).map((p) => <p>{p}</p>)}
            <h3>{s.ideas.tech}</h3>
            {paragraphs(i.tech).map((p) => <p>{p}</p>)}
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .head { padding-bottom: 32px }
  .layout { display: grid; grid-template-columns: 260px 1fr; gap: 48px; align-items: start }
  .toc { position: sticky; top: 80px; font-size: 15px }
  .toc-title { font: 600 12px var(--font-body); text-transform: uppercase; letter-spacing: .06em; color: var(--muted) }
  .toc ol { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--line) }
  .toc li { padding: 4px 0 4px 12px; display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline }
  .toc a { color: var(--ink); font-weight: 600; text-decoration: none } .toc a:hover { color: var(--primary) }
  .status { font: 600 12px var(--font-body); padding: 1px 8px; border-radius: 20px; white-space: nowrap }
  .status.unlikely { background: var(--line); color: var(--muted) }
  .status.likely { background: var(--moss-soft); color: var(--moss) }
  .status.definitely { background: var(--primary-soft); color: var(--primary) }
  .idea { padding-bottom: 40px }
  .idea + .idea { padding-top: 40px; border-top: 1px solid var(--line) }
  .idea h2 { margin: 0 0 6px }
  .idea .meta { color: var(--muted); font-size: 15px }
  .idea h3 { font-size: 18px; margin: 24px 0 6px; color: var(--primary) }
  @media (max-width: 760px) { .layout { grid-template-columns: 1fr; gap: 24px } .toc { position: static } }
</style>
